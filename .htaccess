DirectoryIndex maintenance-page.php
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteEngine On

# HTTPS is required only on the live domain.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|dist\.test|nexaflow\.test)$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Apply the maintenance gate before any API handler reads private data.
RewriteRule ^api/(?!login\.php$|logout\.php$|maintenance-status\.php$|maintenance-entry\.php$)([A-Za-z0-9_-]+\.php)$ api/maintenance-entry.php [END]

# The PHP API is served directly from the project root.
RewriteRule ^api(?:/|$) - [L]
RewriteRule ^maintenance-page\.php$ - [L]
RewriteRule ^dist/index\.html$ maintenance-page.php [L]

# Serve React's generated assets and other files from dist/.
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
RewriteRule ^(.+)$ dist/$1 [L]

# Missing hashed bundles must be a 404, never the React HTML fallback.
RewriteRule ^assets/ - [R=404,L]

# React Router handles /dashboard, /team and future application pages.
RewriteRule ^ maintenance-page.php [L]
