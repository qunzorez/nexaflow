Options -Indexes

# These files contain secrets or implementation-only helpers and must never
# be requested directly over HTTP.
<FilesMatch "^(config(?:\.[^.]+)?|liqpay\.local|db|mailer|plans|claims|runtime-config|verification|rate-limit|task-deadline-notifications|dentistry-erp-(schema|ledger|operations)|telegram|maintenance)\.php$">
  Require all denied
</FilesMatch>
